diff --git a/vllm/utils/lite_profiler.py b/vllm/utils/lite_profiler.py
new file mode 100644
index 0000000..9c21f36
--- /dev/null
+++ b/vllm/utils/lite_profiler.py
@@ -0,0 +1,270 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""LiteProfiler: lightweight, thread-level, opt-in timing instrumentation.
+
+Arming
+------
+The profiler is armed by ``VLLM_LITE_PROFILER_LOG_PATH`` (log file path), which
+must be set *before* the process starts, because
+``vllm.v1.utils.record_function_or_nullcontext`` resolves and caches the
+context-manager factory exactly once per process.
+
+* env unset: the helper keeps returning ``contextlib.nullcontext`` and the
+  phase lane is disabled entirely -- zero collection, zero overhead, behaviour
+  identical to a stock build.
+* env set: scopes become :class:`LiteScope` instances, but nothing is written
+  until :func:`set_lite_profiler_active` is called with ``True`` (wired to
+  ``start_profiling``/``stop_profiling``). Collection can be started and
+  stopped repeatedly inside one process lifetime.
+
+Record format (thread-level)
+----------------------------
+Both record types are *per thread* and carry the OS thread id
+(``threading.get_native_id()``, i.e. the ``/proc/<pid>/task/<tid>`` namespace,
+*not* ``threading.get_ident()``) plus the pid, so that rows from the many
+threads of a worker process (``acl_thread``, ``release_thread``, RT recycle,
+ZMQ IO, ...) and from several processes writing the same file can be told
+apart::
+
+    <scope name>|<duration us>|<start time us>|<tid>|<pid>
+    phase: <phase name>|<duration us>|<start time us>|<tid>|<pid>
+
+The first three columns keep the upstream field order, so an upstream parser
+still reads scope names/durations; ``tid``/``pid`` are appended. Phase bands
+are per-thread as well: ``record_phase`` only closes the band of the calling
+thread, and ``flush_phase``/``set_lite_profiler_active(False)`` close *every*
+thread's band.
+
+Records are written with an open-append-close cycle so that concurrent threads
+and processes can share one log file (small ``O_APPEND`` writes are atomic) and
+so that a ``fork()`` cannot leave an inherited, shared file offset behind.
+"""
+
+import atexit
+import os
+import sys
+import threading
+import time
+
+import vllm.envs as envs
+
+__all__ = [
+    "LiteScope",
+    "flush_phase",
+    "is_lite_profiler_active",
+    "is_lite_profiler_enabled",
+    "maybe_emit_lite_profiler_report",
+    "record_phase",
+    "set_lite_profiler_active",
+]
+
+# Log destination, resolved once at import time. ``None`` disables everything.
+LOG_PATH: str | None = envs.VLLM_LITE_PROFILER_LOG_PATH
+
+# True when the environment variable was set for this process.
+_PHASE_ENABLED = bool(LOG_PATH)
+
+# Runtime switch, flipped by start/stop_profiling only.
+_ACTIVE = False
+
+# phase bands, one per (native) thread id: {tid: (phase_name, start_time_ns)}
+_phase_lock = threading.Lock()
+_PHASE_BY_TID: dict[int, tuple[str, int]] = {}
+
+_get_native_id = threading.get_native_id
+
+
+def _native_id() -> int:
+    """OS thread id (``/proc/<pid>/task/<tid>`` namespace).
+
+    Deliberately ``get_native_id`` and not ``get_ident``: the latter returns a
+    CPython-internal id that cannot be aligned with ``/proc`` or with the
+    worker main TIDs reported by the mapping tooling.
+    """
+    return _get_native_id()
+
+
+def is_lite_profiler_enabled() -> bool:
+    """Whether ``VLLM_LITE_PROFILER_LOG_PATH`` was set for this process."""
+    return _PHASE_ENABLED
+
+
+def is_lite_profiler_active() -> bool:
+    """Whether collection is currently running in this process."""
+    return _ACTIVE
+
+
+def _format_record(name: str, duration_us: float, start_us: int, tid: int) -> str:
+    return f"{name}|{duration_us:.3f}|{start_us}|{tid}|{os.getpid()}"
+
+
+def _write_line(line: str) -> None:
+    """Append one record to the LiteProfiler log.
+
+    Instrumentation must never break the inference path, hence the broad
+    exception handling: a failing log write is silently dropped.
+    """
+    path = LOG_PATH
+    if not path:
+        return
+    try:
+        with open(path, "a") as f:
+            f.write(line)
+            f.write("\n")
+    except OSError:
+        pass
+
+
+class LiteScope:
+    """Timing context manager used in place of ``contextlib.nullcontext``.
+
+    When the profiler is inactive, ``__enter__`` returns immediately without
+    even reading a clock, so the hot-path overhead is a single boolean check.
+    Instances are single-use (constructed per call site) but re-enterable: the
+    recorded state lives in the instance slots and is cleared by ``__exit__``.
+    """
+
+    __slots__ = (
+        "_name",
+        "_recording",
+        "_start_epoch_us",
+        "_start_perf_ns",
+        "_tid",
+    )
+
+    def __init__(self, name: str) -> None:
+        self._name = name
+        self._recording = False
+        self._start_perf_ns = 0
+        self._start_epoch_us = 0
+        self._tid = 0
+
+    def __enter__(self) -> "LiteScope":
+        if _ACTIVE:
+            self._recording = True
+            # perf_counter_ns for the duration (monotonic), time_ns for the
+            # absolute axis (consistent across threads and processes).
+            self._start_perf_ns = time.perf_counter_ns()
+            self._start_epoch_us = time.time_ns() // 1000
+            self._tid = _native_id()
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback) -> bool:
+        if not self._recording:
+            return False
+        self._recording = False
+        if exc_type is None:
+            duration_us = (time.perf_counter_ns() - self._start_perf_ns) / 1000.0
+            _write_line(
+                _format_record(
+                    self._name, duration_us, self._start_epoch_us, self._tid
+                )
+            )
+        return False
+
+
+def _close_band_locked(tid: int, end_ns: int) -> str | None:
+    """Close (and format) one thread's open phase band.
+
+    The caller must hold ``_phase_lock``.
+    """
+    band = _PHASE_BY_TID.pop(tid, None)
+    if band is None:
+        return None
+    name, start_ns = band
+    duration_us = max(end_ns - start_ns, 0) / 1000.0
+    return _format_record(f"phase: {name}", duration_us, start_ns // 1000, tid)
+
+
+def flush_phase() -> None:
+    """Write every thread's currently open phase band, if any.
+
+    Bands are per thread, so this closes all of them (not only the calling
+    thread's), which is what stop_profiling and the ``atexit`` hook need.
+    """
+    if not _PHASE_ENABLED:
+        return
+    now_ns = time.time_ns()
+    with _phase_lock:
+        lines = [
+            line
+            for tid in list(_PHASE_BY_TID)
+            if (line := _close_band_locked(tid, now_ns)) is not None
+        ]
+    for line in lines:
+        _write_line(line)
+
+
+def record_phase(name: str) -> None:
+    """Switch the calling thread's phase lane to ``name``.
+
+    The thread's previously open band is closed and a new band is opened;
+    repeating the same phase is a no-op, which keeps the lane free of one tiny
+    band per engine step. Other threads are unaffected: phases are per-thread
+    so that e.g. "how much of the decode window is the worker main thread's
+    ``Step:Model``" can be answered without cross-thread mixing.
+
+    Does nothing when the profiler is armed but inactive.
+    """
+    if not _PHASE_ENABLED or not _ACTIVE:
+        return
+    tid = _native_id()
+    now_ns = time.time_ns()
+    with _phase_lock:
+        band = _PHASE_BY_TID.get(tid)
+        if band is not None and band[0] == name:
+            return
+        line = _close_band_locked(tid, now_ns)
+        _PHASE_BY_TID[tid] = (name, now_ns)
+    if line is not None:
+        _write_line(line)
+
+
+def set_lite_profiler_active(active: bool) -> None:
+    """Runtime on/off switch driven by start/stop_profiling.
+
+    When switching off, every thread's last (partial) phase band is flushed
+    first so that the lane ends together with the collection window.
+    """
+    global _ACTIVE
+    if active:
+        _ACTIVE = True
+        return
+    if _ACTIVE and _PHASE_ENABLED:
+        flush_phase()
+    _ACTIVE = False
+
+
+def _clear_log() -> None:
+    path = LOG_PATH
+    if not path:
+        return
+    try:
+        with open(path, "w"):
+            pass
+    except OSError:
+        pass
+
+
+def maybe_emit_lite_profiler_report(clear: bool = True) -> None:
+    """Print the LiteProfiler summary and clear the log.
+
+    Called at the end of the benchmark entrypoints. No-op when the profiler was
+    never armed.
+    """
+    if not _PHASE_ENABLED:
+        return
+    flush_phase()
+    try:
+        from vllm.utils.lite_profiler_report import emit_lite_profiler_report
+
+        emit_lite_profiler_report(LOG_PATH)
+    except Exception as e:  # pragma: no cover - reporting must not fail a run
+        print(f"[LiteProfiler] report generation failed: {e}", file=sys.stderr)
+        return
+    if clear:
+        _clear_log()
+
+
+# Make sure no phase band is silently lost on a clean exit.
+atexit.register(flush_phase)
