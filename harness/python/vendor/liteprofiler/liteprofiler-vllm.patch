new file mode 100644
index 0000000..b76c4a9
--- /dev/null
+++ b/vllm/utils/python_stack_sampler.py
@@ -0,0 +1,193 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Background Python stack sampler (``pystack``) for LiteProfiler.
+
+A daemon thread periodically snapshots ``sys._current_frames()`` and appends one
+row per live thread to a CSV file::
+
+    timestamp_us,tid,pid,stack
+
+where ``stack`` is the call stack of that thread, innermost frame first, with
+frames joined by ``::`` and each frame rendered as ``frame_name:line_number``.
+``tid`` is the OS thread id (``threading.get_native_id()``), i.e. it can be
+matched directly against ``/proc/<pid>/task/<tid>`` -- the sampler is
+thread-level by construction.
+
+Configuration (read at start time, so it can be changed between runs):
+
+* ``VLLM_PYSTACK_LOG`` -- output path, default ``/tmp/pystack.csv``.
+* ``VLLM_PYSTACK_INTERVAL_US`` -- sampling interval in microseconds, default
+  ``1000``.
+
+Only sampling of *existing* threads happens here; ``_get()`` manages the single
+module-level sampler instance.
+"""
+
+import csv
+import os
+import sys
+import threading
+import time
+from types import FrameType
+
+__all__ = ["PythonStackSampler", "start_stack_sampler", "stop_stack_sampler"]
+
+DEFAULT_LOG_PATH = "/tmp/pystack.csv"
+DEFAULT_INTERVAL_US = 1000
+
+_LOCK = threading.Lock()
+_SAMPLER: "PythonStackSampler | None" = None
+
+
+def _format_frame(frame: FrameType) -> str:
+    name = frame.f_code.co_name
+    filename = os.path.basename(frame.f_code.co_filename)
+    return f"{name}({filename}):{frame.f_lineno}"
+
+
+def _format_stack(frame: FrameType, max_frames: int) -> str:
+    frames: list[str] = []
+    while frame is not None and len(frames) < max_frames:
+        frames.append(_format_frame(frame))
+        frame = frame.f_back
+    return "::".join(frames)
+
+
+class PythonStackSampler:
+    """Periodically dump the Python stacks of all live threads to CSV."""
+
+    def __init__(
+        self,
+        log_path: str = DEFAULT_LOG_PATH,
+        interval_us: int = DEFAULT_INTERVAL_US,
+        max_frames: int = 64,
+    ) -> None:
+        self.log_path = log_path
+        self.interval_us = max(int(interval_us), 1)
+        self.max_frames = max_frames
+        self._stop_event = threading.Event()
+        self._thread: threading.Thread | None = None
+        self.samples = 0
+        self.errors = 0
+
+    # -- lifecycle ---------------------------------------------------------
+    def start(self) -> None:
+        if self._thread is not None and self._thread.is_alive():
+            return
+        directory = os.path.dirname(os.path.abspath(self.log_path))
+        if directory:
+            os.makedirs(directory, exist_ok=True)
+        self._stop_event.clear()
+        self._thread = threading.Thread(
+            target=self._run,
+            name="LiteProfiler-PyStackSampler",
+            daemon=True,
+        )
+        self._thread.start()
+
+    def stop(self, timeout: float = 2.0) -> None:
+        self._stop_event.set()
+        thread = self._thread
+        if thread is not None and thread.is_alive():
+            thread.join(timeout=timeout)
+        self._thread = None
+
+    def is_running(self) -> bool:
+        return self._thread is not None and self._thread.is_alive()
+
+    # -- sampling ----------------------------------------------------------
+    def _run(self) -> None:
+        interval_s = self.interval_us / 1_000_000.0
+        self._stop_event.wait(interval_s)
+        while not self._stop_event.is_set():
+            started = time.perf_counter()
+            try:
+                self.sample_once()
+            except Exception:  # pragma: no cover - sampling must never kill vLLM
+                self.errors += 1
+            elapsed = time.perf_counter() - started
+            self._stop_event.wait(max(interval_s - elapsed, 0.0))
+
+    def sample_once(self) -> None:
+        """Take one snapshot of all threads and append it to the CSV file."""
+        pid = os.getpid()
+        timestamp_us = time.time_ns() // 1000
+        # ``sys._current_frames()`` is keyed by the CPython thread identifier
+        # (``threading.get_ident()``), *not* by the OS TID. Convert explicitly
+        # so that the ``tid`` column lives in the same namespace as
+        # ``/proc/<pid>/task/<tid>`` and as the worker-main-TID mappings; using
+        # the raw keys here would silently produce an unusable column.
+        threads = [t for t in threading.enumerate() if t.ident is not None]
+        ident_to_native = {t.ident: t.native_id for t in threads}
+        native_to_name = {t.native_id: t.name for t in threads}
+        self_native_id = threading.get_native_id()
+        rows = []
+        for ident, frame in sys._current_frames().items():
+            tid = ident_to_native.get(ident)
+            if tid is None:
+                continue
+            if tid == self_native_id:
+                # Do not report the sampler's own frame.
+                continue
+            rows.append(
+                (
+                    timestamp_us,
+                    tid,
+                    pid,
+                    native_to_name.get(tid, ""),
+                    _format_stack(frame, self.max_frames),
+                )
+            )
+        if not rows:
+            return
+        with open(self.log_path, "a", newline="") as f:
+            writer = csv.writer(f)
+            for row in rows:
+                writer.writerow(row)
+        self.samples += 1
+
+
+def _get() -> PythonStackSampler:
+    """Return the module-level sampler singleton, creating it on first use."""
+    global _SAMPLER
+    with _LOCK:
+        if _SAMPLER is None:
+            _SAMPLER = PythonStackSampler(
+                log_path=os.getenv("VLLM_PYSTACK_LOG", DEFAULT_LOG_PATH),
+                interval_us=int(
+                    os.getenv("VLLM_PYSTACK_INTERVAL_US", str(DEFAULT_INTERVAL_US))
+                ),
+            )
+        return _SAMPLER
+
+
+def _write_header_if_new(path: str) -> None:
+    if os.path.exists(path) and os.path.getsize(path) > 0:
+        return
+    directory = os.path.dirname(os.path.abspath(path))
+    if directory:
+        os.makedirs(directory, exist_ok=True)
+    with open(path, "a", newline="") as f:
+        csv.writer(f).writerow(["timestamp_us", "tid", "pid", "thread_name", "stack"])
+
+
+def start_stack_sampler() -> PythonStackSampler:
+    """Start (or reuse) the process-wide Python stack sampler."""
+    sampler = _get()
+    # Re-read the env vars so a changed path/interval takes effect on restart.
+    sampler.log_path = os.getenv("VLLM_PYSTACK_LOG", DEFAULT_LOG_PATH)
+    sampler.interval_us = max(
+        int(os.getenv("VLLM_PYSTACK_INTERVAL_US", str(DEFAULT_INTERVAL_US))), 1
+    )
+    _write_header_if_new(sampler.log_path)
+    sampler.start()
+    return sampler
+
+
+def stop_stack_sampler() -> None:
+    """Stop the process-wide Python stack sampler, if it is running."""
+    with _LOCK:
+        sampler = _SAMPLER
+    if sampler is None:
+        return
+    sampler.stop()
diff --git a/vllm/utils/topdown_torch.py b/vllm/utils/topdown_torch.py
new file mode 100644
index 0000000..d15c6b5
--- /dev/null
+++ b/vllm/utils/topdown_torch.py
@@ -0,0 +1,272 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Glue between the built-in Kunpeng TopDown sampler and torch profiler traces.
+
+The torch profiler writes a chrome trace with its own time base. To place PMU
+counter samples on that axis, the companion injects two ``record_function``
+anchors (``topdown:anchor:start`` / ``topdown:anchor:stop``) that carry the wall
+clock as an argument; the wall-clock/trace offset is recovered from them, and
+the TopDown samples are then appended as ``ph: "C"`` counter events.
+
+``torch`` is imported lazily inside the methods so that importing this module
+costs nothing when the TopDown companion is not used.
+"""
+
+import gzip
+import json
+import os
+import time
+
+from vllm.logger import init_logger
+
+__all__ = ["TorchTopdownCompanion", "merge_topdown_into_trace", "newest_trace_file"]
+
+logger = init_logger(__name__)
+
+ANCHOR_START = "topdown:anchor:start"
+ANCHOR_STOP = "topdown:anchor:stop"
+
+# The wall clock is encoded as a suffix in the annotation *name*, not in its
+# ``args``: torch's chrome-trace export overwrites the ``args`` of user
+# annotations (they come out as {'External id': .., 'Record function id': ..}),
+# so anything passed as the second argument of ``record_function`` is lost.
+# Verified in the v0.26.0rc1 image with torch 2.x:
+#   record_function("topdown:anchor:start", '{"wall_us": ...}')
+#   -> traceEvents entry args == {'External id': 1, 'Record function id': 0, ...}
+ANCHOR_SEPARATOR = "@"
+
+
+def _open_trace(path: str, mode: str = "rt"):
+    if path.endswith(".gz"):
+        return gzip.open(path, mode)
+    return open(path, mode)
+
+
+def _load_trace(path: str) -> dict:
+    with _open_trace(path) as f:
+        return json.load(f)
+
+
+def _dump_trace(path: str, payload: dict) -> None:
+    with _open_trace(path, "wt") as f:
+        json.dump(payload, f)
+
+
+def _find_anchor(events: list[dict], name: str) -> dict | None:
+    for event in events:
+        event_name = str(event.get("name", ""))
+        if event_name == name and "ts" in event:
+            return event
+        if event_name.startswith(name + ANCHOR_SEPARATOR) and "ts" in event:
+            return event
+    return None
+
+
+def _wall_us(event: dict) -> int | None:
+    """Wall clock of an anchor: name suffix first, legacy ``args`` second."""
+    name = str(event.get("name", ""))
+    if ANCHOR_SEPARATOR in name:
+        suffix = name.rsplit(ANCHOR_SEPARATOR, 1)[1]
+        if suffix.isdigit():
+            return int(suffix)
+    args = event.get("args") or {}
+    value = args.get("wall_us")
+    return int(value) if value is not None else None
+
+
+def newest_trace_file(log_dir: str, use_gzip: bool = True) -> str | None:
+    """Return the most recent ``*.pt.trace.json*`` file below ``log_dir``."""
+    candidates: list[tuple[float, str]] = []
+    for root, _dirs, files in os.walk(log_dir or "."):
+        for name in files:
+            if ".pt.trace.json" not in name:
+                continue
+            if use_gzip and not name.endswith(".gz"):
+                continue
+            if not use_gzip and name.endswith(".gz"):
+                continue
+            path = os.path.join(root, name)
+            try:
+                candidates.append((os.path.getmtime(path), path))
+            except OSError:
+                continue
+    if not candidates:
+        return None
+    return max(candidates)[1]
+
+
+def merge_topdown_into_trace(trace_path: str, samples: list[dict]) -> dict:
+    """Append TopDown samples to ``trace_path`` as ``ph: "C"`` counter events.
+
+    ``samples`` is the list produced by
+    :meth:`vllm.utils.perf_topdown.TopdownSample.to_row`. The returned summary
+    describes what was merged and at which granularity the counters were
+    collected.
+    """
+    payload = _load_trace(trace_path)
+    events = payload.get("traceEvents", [])
+    start_anchor = _find_anchor(events, ANCHOR_START)
+    stop_anchor = _find_anchor(events, ANCHOR_STOP)
+    if start_anchor is None or stop_anchor is None:
+        return {
+            "merged": 0,
+            "reason": "anchors not found in trace",
+            "trace": trace_path,
+        }
+    start_wall = _wall_us(start_anchor)
+    stop_wall = _wall_us(stop_anchor)
+    if start_wall is None:
+        return {"merged": 0, "reason": "anchor without wall_us", "trace": trace_path}
+
+    # Trace timestamps are microseconds since the profiler's own base.
+    offset_us = int(start_anchor["ts"]) - start_wall
+    pid = start_anchor.get("pid", 0)
+    tid = start_anchor.get("tid", 0)
+
+    merged = 0
+    granularities: set[str] = set()
+    for sample in samples:
+        timestamp_us = int(sample.get("timestamp_us", 0))
+        if timestamp_us <= 0:
+            continue
+        if stop_wall is not None and not (start_wall <= timestamp_us <= stop_wall):
+            continue
+        granularity = str(sample.get("granularity", "unknown"))
+        granularities.add(granularity)
+        ts = timestamp_us + offset_us
+        for key, value in sample.items():
+            if not (key.startswith("td_") or key.startswith("scaled_")):
+                continue
+            events.append(
+                {
+                    "name": f"topdown[{granularity}]: {key}",
+                    "ph": "C",
+                    "ts": ts,
+                    "pid": pid,
+                    "tid": tid,
+                    "args": {
+                        "value": value,
+                        "granularity": granularity,
+                        "pid_arg": sample.get("pid_arg"),
+                        "cpu_arg": sample.get("cpu_arg"),
+                        "sampled_tid": sample.get("tid"),
+                    },
+                }
+            )
+            merged += 1
+    if merged:
+        _dump_trace(trace_path, payload)
+    return {
+        "merged": merged,
+        "trace": trace_path,
+        "offset_us": offset_us,
+        "granularities": sorted(granularities),
+        "samples": len(samples),
+    }
+
+
+class TorchTopdownCompanion:
+    """Start/stop the PMU sampler alongside a torch profiler session.
+
+    The companion is inert unless ``enabled`` is set (the caller wires it to
+    ``ProfilerConfig.torch_profiler_with_topdown``); it is always safe to
+    construct.
+    """
+
+    def __init__(
+        self,
+        log_dir: str,
+        enabled: bool = True,
+        cycle_period: int = 500_000,
+        tid: int | None = None,
+        cpu: int = -1,
+        exclude_kernel: bool = False,
+    ) -> None:
+        self.log_dir = log_dir
+        self.enabled = enabled
+        # cycle_period is expressed in nanoseconds, matching the profiler config
+        # field name; the PMU sampler works in microseconds.
+        self.interval_us = max(int(cycle_period) // 1000, 1)
+        self.tid = tid
+        self.cpu = cpu
+        self.exclude_kernel = exclude_kernel
+        self.csv_path = os.path.join(log_dir or ".", "topdown.csv")
+        self.session = None
+        self.samples: list[dict] = []
+        self._anchor_ctx = None
+        self.error: str | None = None
+
+    # -- anchors -----------------------------------------------------------
+    def _annotate(self, name: str):
+        """Open a ``record_function`` anchor (lazy torch import).
+
+        The wall clock travels in the annotation name because torch's trace
+        export drops the ``args`` payload of user annotations.
+        """
+        try:
+            from torch.profiler import record_function
+        except Exception:  # pragma: no cover - torch is a dependency of vLLM
+            return None
+        ctx = record_function(f"{name}{ANCHOR_SEPARATOR}{time.time_ns() // 1000}")
+        return ctx.__enter__()
+
+    def _annotate_exit(self) -> None:
+        ctx = self._anchor_ctx
+        self._anchor_ctx = None
+        if ctx is None:
+            return
+        try:
+            ctx.__exit__(None, None, None)
+        except Exception:  # pragma: no cover - annotation must never fail a run
+            pass
+
+    # -- lifecycle ---------------------------------------------------------
+    def start(self) -> bool:
+        """Start the PMU session. Returns ``True`` if sampling actually started."""
+        self._anchor_ctx = self._annotate(ANCHOR_START)
+        if not self.enabled:
+            return False
+        from vllm.utils.perf_topdown import (
+            TopdownEventValidationError,
+            TopdownSession,
+            TopdownUnavailableError,
+        )
+
+        os.makedirs(self.log_dir, exist_ok=True)
+        session = TopdownSession(
+            log_path=self.csv_path,
+            tid=self.tid,
+            cpu=self.cpu,
+            interval_us=self.interval_us,
+        )
+        try:
+            session.start_background()
+        except (TopdownUnavailableError, TopdownEventValidationError) as e:
+            # Fail closed: no top-down data at all rather than a profile built
+            # from a dead (silently zero) PMU event code.
+            self.error = str(e)
+            logger.warning_once("TopDown companion not started: %s", e)
+            return False
+        self.session = session
+        return True
+
+    def stop(self) -> list[dict]:
+        """Stop the PMU session and return the collected rows."""
+        self._annotate_exit()
+        session = self.session
+        self.session = None
+        if session is None:
+            return self.samples
+        session.stop()
+        self.samples = [sample.to_row() for sample in session.samples]
+        return self.samples
+
+    # -- merging -----------------------------------------------------------
+    def merge_latest_trace(self, use_gzip: bool = True) -> dict:
+        """Merge the collected samples into the newest trace in ``log_dir``."""
+        trace = newest_trace_file(self.log_dir, use_gzip=use_gzip)
+        if trace is None:
+            return {"merged": 0, "reason": "no trace file found", "dir": self.log_dir}
+        if not self.samples:
+            return {"merged": 0, "reason": "no topdown samples", "trace": trace}
+        return merge_topdown_into_trace(trace, self.samples)
