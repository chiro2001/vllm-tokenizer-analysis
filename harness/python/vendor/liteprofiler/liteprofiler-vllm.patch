@@ -0,0 +1,825 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Pure-Python Kunpeng TopDown PMI sampling (no libkperf dependency).
+
+Raw Kunpeng PMU events are read straight from ``perf_event_open(2)`` through
+``ctypes``, so the sampler works in any container that has PMU permission --
+no DevKit, no libkperf, no external ``perf`` binary.
+
+Granularity is *explicit*: PMU events are per-thread or per-CPU depending on the
+``pid``/``cpu`` arguments passed to ``perf_event_open``. Every sample row is
+therefore annotated with the exact ``pid``/``cpu`` pair that was used and with a
+``granularity`` string, and every session writes a one-line metadata header
+into its output file before any sample:
+
+* ``pid = <native TID>, cpu = -1`` -> ``thread``: exact thread-level counts, the
+  same granularity as ``perf stat -t <TID>``;
+* ``pid = 0, cpu = -1`` -> ``process``: the whole calling process (thread group);
+* ``pid = -1, cpu = N`` -> ``cpu``: system-wide on one CPU.
+
+Only the first form may be compared with the project's exact-TID top-down
+buckets; the other two must be labelled as process/CPU-level background.
+
+The L1 bucket definitions come from ``920B_topdown.txt``::
+
+    inst_retired=r08
+    fetch_bubble=r2011
+    cycle=r11
+    inst_spec=r1b
+    issue_width=6
+
+    frontend_bound = fetch_bubble / (issue_width * cycles) * 100
+    bad_spec       = (inst_spec - inst_retired) / (issue_width * cycles) * 100
+    retiring       = inst_retired / (issue_width * cycle)
+    backend_bound  = 100 - frontend_bound - bad_spec - retiring
+
+Event-code conflict
+-------------------
+``lite-profiler-desc.md`` mentions ``r1f21`` as the fetch-bubble event for the
+0xd02 part, while ``920B_topdown.txt`` uses ``r2011``. Measured on the actual
+a3-21/a3-22 hosts (``CPU part: 0xd02``) with an identical busy workload::
+
+    $ sudo perf stat -e r08,r2011,r11,r1b -- python3 -c "sum(i*i for i in range(3000000))"
+    2502091776 r08 | 172829197 r2011 | 537370734 r11 | 2533599934 r1b
+    $ sudo perf stat -e r08,r1f21,r11,r1b -- python3 -c "sum(i*i for i in range(3000000))"
+    2502129509 r08 |         0 r1f21 | 539357290 r11 | 2533928724 r1b
+
+``r1f21`` is accepted by the kernel and silently counts **0** on 0xd02, which
+would make ``frontend_bound`` 0 % and dump the whole budget into
+``backend_bound`` -- a plausible looking but wrong profile. Therefore:
+
+* the default fetch-bubble event is ``0x2011`` (hardware-verified here), the
+  ``0x1f21`` code is only reachable through
+  ``VLLM_TOPDOWN_FETCH_BUBBLE_EVENT``;
+* :func:`validate_event_codes` runs a fail-closed pre-flight: every counter is
+  read over a short known-non-zero CPU workload and **all** of them have to
+  count, otherwise the session refuses to start. "Counter is 0" can mean "the
+  event never happened" or "this event code is dead on this CPU", and for a
+  pre-flight over a busy loop only the second meaning is possible.
+"""
+
+import ctypes
+import ctypes.util
+import json
+import os
+import platform
+import threading
+import time
+from dataclasses import dataclass, field
+
+__all__ = [
+    "EVENT_CODES",
+    "KunpengPmiSampler",
+    "KNOWN_DEAD_EVENT_CODES",
+    "PMI_COUNTERS",
+    "TopdownSession",
+    "TopdownEventValidationError",
+    "TopdownUnavailableError",
+    "compute_buckets",
+    "detect_variant",
+    "perf_event_open",
+    "probe_event_counters",
+    "read_counter",
+    "topdown_scope",
+    "validate_event_codes",
+]
+
+# ---------------------------------------------------------------------------
+# perf_event_open plumbing
+# ---------------------------------------------------------------------------
+
+PERF_TYPE_RAW = 4
+PERF_FORMAT_TOTAL_TIME_ENABLED = 1 << 0
+PERF_FORMAT_TOTAL_TIME_RUNNING = 1 << 1
+PERF_READ_FORMAT = PERF_FORMAT_TOTAL_TIME_ENABLED | PERF_FORMAT_TOTAL_TIME_RUNNING
+
+PMI_COUNTERS = ("inst_retired", "fetch_bubble", "cycle", "inst_spec")
+
+# Raw event codes as used by ``perf ... -e r08,r2011,r11,r1b``.
+EVENT_CODES = {
+    "inst_retired": 0x08,
+    "fetch_bubble": 0x2011,
+    "cycle": 0x11,
+    "inst_spec": 0x1B,
+}
+
+#: Raw event codes that are accepted by the kernel but never count on the parts
+#: we have measured. Kept only for the diagnosis message: the fail-closed
+#: pre-flight in :func:`validate_event_codes` is what actually protects us.
+KNOWN_DEAD_EVENT_CODES = {
+    0x1F21: (
+        "reads 0 without any error on CPU part 0xd02 (a3-21/a3-22); "
+        "lite-profiler-desc.md lists it as fetch_bubble, 920B_topdown.txt "
+        "and the measurements use r2011"
+    ),
+}
+
+SAMPLE_COLUMNS = (
+    "timestamp_us",
+    "pid_arg",
+    "cpu_arg",
+    "tid",
+    "granularity",
+)
+SAMPLE_COLUMNS = SAMPLE_COLUMNS + tuple(f"raw_{c}" for c in PMI_COUNTERS)
+SAMPLE_COLUMNS = SAMPLE_COLUMNS + tuple(f"scaled_{c}" for c in PMI_COUNTERS)
+SAMPLE_COLUMNS = SAMPLE_COLUMNS + (
+    "td_frontend_bound",
+    "td_bad_spec",
+    "td_retiring",
+    "td_backend_bound",
+)
+
+_SYS_perf_event_open = {
+    "aarch64": 241,
+    "arm64": 241,
+    "x86_64": 298,
+}.get(platform.machine(), -1)
+
+_FLAG_EXCLUDE_KERNEL = 1 << 5
+
+
+class TopdownUnavailableError(RuntimeError):
+    """Raised when PMU events cannot be opened (permissions, no PMU, ...)."""
+
+
+class TopdownEventValidationError(RuntimeError):
+    """Raised when an event code does not count on this CPU (fail-closed).
+
+    A raw event code may be accepted by the kernel and still count 0 forever
+    (measured: ``r1f21`` on CPU part ``0xd02``). Producing a top-down profile
+    from such a counter yields a *plausible but wrong* result, so the sampler
+    refuses to run instead.
+    """
+
+
+class _PerfEventAttr(ctypes.Structure):
+    """``struct perf_event_attr`` (fields up to ``config2``)."""
+
+    _fields_ = (
+        ("type", ctypes.c_uint32),
+        ("size", ctypes.c_uint32),
+        ("config", ctypes.c_uint64),
+        ("sample_period", ctypes.c_uint64),
+        ("sample_type", ctypes.c_uint64),
+        ("read_format", ctypes.c_uint64),
+        ("flags", ctypes.c_uint64),
+        ("wakeup_events", ctypes.c_uint32),
+        ("bp_type", ctypes.c_uint32),
+        ("config1", ctypes.c_uint64),
+        ("config2", ctypes.c_uint64),
+    )
+
+
+def _libc() -> ctypes.CDLL:
+    libc = ctypes.CDLL(ctypes.util.find_library("c") or "libc.so.6", use_errno=True)
+    libc.syscall.restype = ctypes.c_long
+    libc.read.restype = ctypes.c_ssize_t
+    return libc
+
+
+def perf_event_open(
+    config: int,
+    pid: int,
+    cpu: int,
+    group_fd: int = -1,
+    flags: int = 0,
+    event_type: int = PERF_TYPE_RAW,
+    read_format: int = PERF_READ_FORMAT,
+    exclude_kernel: bool = False,
+    syscall_number: int | None = None,
+) -> int:
+    """Thin ``perf_event_open(2)`` wrapper returning a file descriptor.
+
+    Raises :class:`TopdownUnavailableError` (carrying the errno) when the kernel
+    refuses to create the event.
+    """
+    number = _SYS_perf_event_open if syscall_number is None else syscall_number
+    if number < 0:
+        raise TopdownUnavailableError(
+            f"perf_event_open syscall number unknown for {platform.machine()!r}"
+        )
+    attr = _PerfEventAttr()
+    attr.type = event_type
+    attr.size = ctypes.sizeof(_PerfEventAttr)
+    attr.config = config
+    attr.sample_period = 0
+    attr.sample_type = 0
+    attr.read_format = read_format
+    attr.flags = _FLAG_EXCLUDE_KERNEL if exclude_kernel else 0
+    libc = _libc()
+    fd = libc.syscall(
+        ctypes.c_long(number),
+        ctypes.byref(attr),
+        ctypes.c_int(pid),
+        ctypes.c_int(cpu),
+        ctypes.c_int(group_fd),
+        ctypes.c_ulong(flags),
+    )
+    if fd < 0:
+        errno = ctypes.get_errno()
+        raise TopdownUnavailableError(
+            f"perf_event_open(config=0x{config:x}, pid={pid}, cpu={cpu}) "
+            f"failed: errno={errno} ({os.strerror(errno)})"
+        )
+    return int(fd)
+
+
+def read_counter(fd: int) -> tuple[int, int, int]:
+    """Read one counter, returning ``(value, time_enabled, time_running)``."""
+    buf = (ctypes.c_uint64 * 3)()
+    read = _libc().read(ctypes.c_int(fd), ctypes.byref(buf), ctypes.c_size_t(24))
+    if read != 24:
+        raise TopdownUnavailableError(f"short perf read ({read} bytes) on fd {fd}")
+    return int(buf[0]), int(buf[1]), int(buf[2])
+
+
+# ---------------------------------------------------------------------------
+# CPU variant detection
+# ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class KunpengVariant:
+    name: str
+    cpu_part: str
+    fetch_bubble_event: int
+    issue_width: int
+    source: str
+    verified: bool = False
+
+    @property
+    def events(self) -> dict[str, int]:
+        events = dict(EVENT_CODES)
+        events["fetch_bubble"] = self.fetch_bubble_event
+        return events
+
+
+# cpu_part: (name, fetch_bubble raw event, issue width, source, verified)
+#
+# NOTE: the names are deliberately neutral ("kunpeng-<part id>"). The mapping
+# from the /proc/cpuinfo part id to a marketing name (920 vs 920B) is not
+# verified: both real hosts we have report ``CPU part: 0xd02`` while
+# 920B_topdown.txt is labelled "920B", so an id->name mapping would be a guess.
+_VARIANTS = {
+    "0xd01": (
+        "kunpeng-0xd01",
+        0x2011,
+        6,
+        "920B_topdown.txt (r2011); part-id to marketing-name mapping unverified",
+        False,
+    ),
+    # The fetch-bubble code for this part is r2011, not the r1f21 mentioned in
+    # lite-profiler-desc.md: r1f21 silently counts 0 here.
+    "0xd02": (
+        "kunpeng-0xd02",
+        0x2011,
+        6,
+        "hardware-verified on a3-21/a3-22 (0xd02): r2011 counts, r1f21 returns 0",
+        True,
+    ),
+}
+
+
+def _cpu_part() -> str:
+    try:
+        with open("/proc/cpuinfo") as f:
+            for line in f:
+                key, _, value = line.partition(":")
+                if key.strip() == "CPU part":
+                    return value.strip().lower()
+    except OSError:
+        pass
+    return ""
+
+
+def detect_variant() -> KunpengVariant:
+    """Detect the Kunpeng variant (fetch-bubble event code and issue width).
+
+    ``VLLM_TOPDOWN_FETCH_BUBBLE_EVENT`` and ``VLLM_TOPDOWN_ISSUE_WIDTH``
+    override the table values, which is the escape hatch for parts whose event
+    code has not been verified on hardware.
+    """
+    part = _cpu_part() or os.getenv("VLLM_TOPDOWN_CPU_PART", "").lower()
+    name, event, width, source, verified = _VARIANTS.get(
+        part,
+        (
+            f"kunpeng-{part or 'unknown'}",
+            EVENT_CODES["fetch_bubble"],
+            6,
+            "default table (part id not in the table), event codes unverified",
+            False,
+        ),
+    )
+    override_event = os.getenv("VLLM_TOPDOWN_FETCH_BUBBLE_EVENT")
+    if override_event:
+        event = int(override_event, 0)
+        source = f"{source} + VLLM_TOPDOWN_FETCH_BUBBLE_EVENT"
+        verified = False
+    override_width = os.getenv("VLLM_TOPDOWN_ISSUE_WIDTH")
+    if override_width:
+        width = int(override_width)
+        source = f"{source} + VLLM_TOPDOWN_ISSUE_WIDTH"
+    return KunpengVariant(
+        name=name,
+        cpu_part=part,
+        fetch_bubble_event=event,
+        issue_width=width,
+        source=source,
+        verified=verified,
+    )
+
+
+def compute_buckets(
+    counters: dict[str, float], issue_width: int = 6
+) -> dict[str, float]:
+    """L1 buckets from the ``920B_topdown.txt`` definitions."""
+    cycles = counters.get("cycle", 0.0)
+    denom = issue_width * cycles
+    if denom <= 0:
+        return {
+            "frontend_bound": 0.0,
+            "bad_spec": 0.0,
+            "retiring": 0.0,
+            "backend_bound": 0.0,
+        }
+    inst_retired = counters.get("inst_retired", 0.0)
+    fetch_bubble = counters.get("fetch_bubble", 0.0)
+    inst_spec = counters.get("inst_spec", 0.0)
+    frontend_bound = fetch_bubble / denom * 100.0
+    bad_spec = (inst_spec - inst_retired) / denom * 100.0
+    # NOTE: the source definition mixes a ratio (retiring) with percentages,
+    # which is why the original document lists retiring without a "%". It is
+    # kept as-is so the numbers stay comparable with
+    # scripts/parse_topdown_l1.py (which documents the same defect).
+    retiring = inst_retired / denom
+    backend_bound = 100.0 - frontend_bound - bad_spec - retiring
+    return {
+        "frontend_bound": frontend_bound,
+        "bad_spec": bad_spec,
+        "retiring": retiring,
+        "backend_bound": backend_bound,
+    }
+
+
+# ---------------------------------------------------------------------------
+# Sampler / sessions
+# ---------------------------------------------------------------------------
+
+
+def _granularity(pid_arg: int, cpu_arg: int) -> str:
+    if cpu_arg >= 0:
+        return "cpu"
+    if pid_arg == 0:
+        return "process"
+    if pid_arg > 0:
+        return "thread"
+    return "system"
+
+
+def probe_event_counters(
+    events: dict[str, int] | None = None,
+    spin_us: int = 300_000,
+    pid: int | None = None,
+    cpu: int = -1,
+    exclude_kernel: bool = False,
+) -> dict[str, int]:
+    """Count each event in the *calling* thread over a known busy workload.
+
+    Returns ``{counter_name: delta}``. Raises
+    :class:`TopdownUnavailableError` when the events cannot be opened at all.
+    """
+    events = dict(events or EVENT_CODES)
+    if pid is None:
+        pid = threading.get_native_id()
+    fds = {
+        name: perf_event_open(
+            config, pid=pid, cpu=cpu, exclude_kernel=exclude_kernel
+        )
+        for name, config in events.items()
+    }
+    try:
+        before = {name: read_counter(fd)[0] for name, fd in fds.items()}
+        # Busy loop in this thread: it retires instructions, consumes cycles and
+        # generates fetch bubbles, so every valid counter must move.
+        deadline = time.perf_counter() + spin_us / 1_000_000.0
+        acc = 0
+        while time.perf_counter() < deadline:
+            for i in range(20_000):
+                acc += i * i
+        after = {name: read_counter(fd)[0] for name, fd in fds.items()}
+    finally:
+        for fd in fds.values():
+            try:
+                os.close(fd)
+            except OSError:
+                pass
+    if acc < 0:  # keep the busy loop from being optimized away
+        print(acc)
+    return {name: after[name] - before[name] for name in fds}
+
+
+def _override_hint(counter: str, event_code: int) -> str:
+    env_name = {
+        "fetch_bubble": "VLLM_TOPDOWN_FETCH_BUBBLE_EVENT",
+    }.get(counter)
+    lines = []
+    if event_code in KNOWN_DEAD_EVENT_CODES:
+        lines.append(
+            f"  note: 0x{event_code:x} is a known-dead code -> "
+            f"{KNOWN_DEAD_EVENT_CODES[event_code]}"
+        )
+    if env_name is not None:
+        lines.append(
+            f"  override manually, e.g.  export {env_name}=0x2011"
+        )
+    lines.append(
+        "  or set VLLM_TOPDOWN_SKIP_EVENT_VALIDATION=1 to bypass the check "
+        "(the resulting top-down numbers must then be treated as unverified)"
+    )
+    return "\n".join(lines)
+
+
+def validate_event_codes(
+    variant: KunpengVariant | None = None,
+    events: dict[str, int] | None = None,
+    spin_us: int = 300_000,
+    min_delta: int = 1,
+    pid: int | None = None,
+) -> dict[str, int]:
+    """Fail-closed pre-flight: every event code must actually count.
+
+    Runs a short known-non-zero CPU workload in the calling thread and requires
+    every configured counter to increase by at least ``min_delta``. A counter
+    that stays at 0 means the raw event code is not valid on this CPU (it can
+    still be accepted by the kernel, as ``r1f21`` on 0xd02), so the sampler must
+    not produce a report -- otherwise ``frontend_bound`` silently becomes 0 %
+    and ``backend_bound`` absorbs the whole budget.
+
+    Returns the measured deltas on success, raises
+    :class:`TopdownEventValidationError` on failure.
+    """
+    variant = variant or detect_variant()
+    events = dict(events or variant.events)
+    try:
+        deltas = probe_event_counters(
+            events=events, spin_us=spin_us, pid=pid, cpu=-1
+        )
+    except TopdownUnavailableError:
+        raise
+    dead = {name: deltas[name] for name in deltas if deltas[name] < min_delta}
+    if dead:
+        details = "\n".join(
+            f"  {name}: code 0x{events[name]:x} counted {deltas[name]}"
+            for name in dead
+        )
+        hints = "\n".join(
+            _override_hint(name, events[name]) for name in dead
+        )
+        raise TopdownEventValidationError(
+            "PMU event-code validation FAILED: a known-non-zero CPU workload "
+            "left the following counters at 0:\n"
+            f"{details}\n"
+            f"measured deltas: {deltas}\n"
+            f"variant: {variant.name} (cpu_part={variant.cpu_part!r}, "
+            f"fetch_bubble=0x{variant.fetch_bubble_event:x}, source={variant.source})\n"
+            "This means the event code is invalid on this CPU (a dead code can "
+            "be accepted by the kernel and still count 0 - exactly how r1f21 "
+            "behaves on 0xd02). Refusing to emit a top-down profile, because "
+            "frontend_bound would silently read 0% and be folded into "
+            "backend_bound.\n"
+            f"{hints}"
+        )
+    return deltas
+
+
+@dataclass
+class TopdownSample:
+    timestamp_us: int
+    pid_arg: int
+    cpu_arg: int
+    tid: int
+    granularity: str
+    counters: dict[str, float] = field(default_factory=dict)
+    raw_counters: dict[str, int] = field(default_factory=dict)
+    buckets: dict[str, float] = field(default_factory=dict)
+
+    def to_row(self) -> dict[str, object]:
+        row: dict[str, object] = {
+            "timestamp_us": self.timestamp_us,
+            "pid_arg": self.pid_arg,
+            "cpu_arg": self.cpu_arg,
+            "tid": self.tid,
+            "granularity": self.granularity,
+        }
+        row.update({f"raw_{k}": v for k, v in self.raw_counters.items()})
+        row.update({f"scaled_{k}": round(v, 3) for k, v in self.counters.items()})
+        row.update({f"td_{k}": round(v, 4) for k, v in self.buckets.items()})
+        return row
+
+
+class KunpengPmiSampler:
+    """Per-thread (or per-process/per-CPU) Kunpeng PMI counter reader.
+
+    ``tid`` is the target thread id; when it is ``None`` the *calling* thread is
+    measured (``pid_arg = threading.get_native_id()``), which keeps the data
+    thread-level. Pass ``tid=0`` for a deliberate whole-process measurement or
+    ``cpu=N`` for a deliberate per-CPU measurement; both are labelled as such in
+    :meth:`describe`.
+    """
+
+    def __init__(
+        self,
+        tid: int | None = None,
+        cpu: int = -1,
+        events: dict[str, int] | None = None,
+        variant: KunpengVariant | None = None,
+        exclude_kernel: bool = False,
+        dry_run: bool = False,
+        validate: bool | None = None,
+    ) -> None:
+        self.variant = variant or detect_variant()
+        self.events = dict(events or self.variant.events)
+        self.cpu_arg = cpu
+        if tid is None:
+            tid = threading.get_native_id()
+        self.pid_arg = int(tid)
+        self.tid = int(tid)
+        self.exclude_kernel = exclude_kernel
+        self.dry_run = dry_run
+        if validate is None:
+            validate = not os.getenv("VLLM_TOPDOWN_SKIP_EVENT_VALIDATION")
+        self.validate = validate
+        self.validation_deltas: dict[str, int] | None = None
+        self.granularity = _granularity(self.pid_arg, self.cpu_arg)
+        self._fds: dict[str, int] = {}
+        self._running = False
+
+    # -- lifecycle ---------------------------------------------------------
+    def start(self) -> None:
+        if self._running:
+            return
+        if self.dry_run:
+            self._running = True
+            return
+        # Fail-closed pre-flight: a dead event code is accepted by the kernel and
+        # counts 0, which would silently produce a wrong top-down profile.
+        if self.validate and not os.getenv("VLLM_TOPDOWN_SKIP_EVENT_VALIDATION"):
+            self.validation_deltas = validate_event_codes(
+                variant=self.variant, events=self.events
+            )
+        opened: dict[str, int] = {}
+        try:
+            for counter in PMI_COUNTERS:
+                opened[counter] = perf_event_open(
+                    self.events[counter],
+                    pid=self.pid_arg,
+                    cpu=self.cpu_arg,
+                    exclude_kernel=self.exclude_kernel,
+                )
+        except TopdownUnavailableError:
+            for fd in opened.values():
+                os.close(fd)
+            raise
+        self._fds = opened
+        self._running = True
+
+    def stop(self) -> None:
+        for fd in self._fds.values():
+            try:
+                os.close(fd)
+            except OSError:
+                pass
+        self._fds = {}
+        self._running = False
+
+    def __enter__(self) -> "KunpengPmiSampler":
+        self.start()
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback) -> bool:
+        self.stop()
+        return False
+
+    # -- sampling ----------------------------------------------------------
+    def sample(self) -> TopdownSample:
+        raw: dict[str, int] = {}
+        scaled: dict[str, float] = {}
+        if self.dry_run:
+            raw = {counter: 0 for counter in PMI_COUNTERS}
+            scaled = {counter: 0.0 for counter in PMI_COUNTERS}
+        else:
+            if not self._running:
+                raise TopdownUnavailableError("sampler is not running")
+            for counter in PMI_COUNTERS:
+                value, enabled, running = read_counter(self._fds[counter])
+                raw[counter] = value
+                # Scale for multiplexing, exactly like `perf stat`.
+                if running > 0 and enabled > running:
+                    scaled[counter] = value * enabled / running
+                else:
+                    scaled[counter] = float(value)
+        return TopdownSample(
+            timestamp_us=time.time_ns() // 1000,
+            pid_arg=self.pid_arg,
+            cpu_arg=self.cpu_arg,
+            tid=self.tid,
+            granularity=self.granularity,
+            counters=scaled,
+            raw_counters=raw,
+            buckets=compute_buckets(scaled, self.variant.issue_width),
+        )
+
+    # -- self-description --------------------------------------------------
+    def describe(self) -> dict[str, object]:
+        """The pid/cpu pair actually used, i.e. the granularity proof."""
+        return {
+            "perf_event_open": {
+                "pid": self.pid_arg,
+                "cpu": self.cpu_arg,
+                "exclude_kernel": self.exclude_kernel,
+                "read_format": "PERF_FORMAT_TOTAL_TIME_ENABLED|TOTAL_TIME_RUNNING",
+            },
+            "granularity": self.granularity,
+            "target_tid": self.tid,
+            "event_validation": {
+                "enabled": bool(self.validate)
+                and not bool(os.getenv("VLLM_TOPDOWN_SKIP_EVENT_VALIDATION")),
+                "deltas": self.validation_deltas,
+            },
+            "variant": {
+                "name": self.variant.name,
+                "cpu_part": self.variant.cpu_part,
+                "fetch_bubble_event": hex(self.variant.fetch_bubble_event),
+                "issue_width": self.variant.issue_width,
+                "source": self.variant.source,
+                "event_codes_verified_on_hardware": self.variant.verified,
+            },
+            "events": {k: hex(v) for k, v in self.events.items()},
+        }
+
+
+class TopdownSession:
+    """Sample one thread's (or process's/CPU's) PMI counters into a CSV file.
+
+    The file starts with a ``# meta`` line recording the exact
+    ``perf_event_open`` ``pid``/``cpu`` arguments, the granularity and the
+    detected variant, followed by a CSV header and one row per sample.
+    """
+
+    def __init__(
+        self,
+        log_path: str,
+        tid: int | None = None,
+        cpu: int = -1,
+        interval_us: int = 100_000,
+        duration_us: int | None = None,
+        dry_run: bool = False,
+        validate: bool | None = None,
+    ) -> None:
+        self.log_path = log_path
+        self.interval_us = max(int(interval_us), 1)
+        self.duration_us = duration_us
+        self.sampler = KunpengPmiSampler(
+            tid=tid, cpu=cpu, dry_run=dry_run, validate=validate
+        )
+        self.samples: list[TopdownSample] = []
+        self._stop_event = threading.Event()
+        self._thread: threading.Thread | None = None
+        self._header_written = False
+        self.invalid_reason: str | None = None
+
+    # -- output ------------------------------------------------------------
+    def _write_meta(self) -> None:
+        directory = os.path.dirname(os.path.abspath(self.log_path))
+        if directory:
+            os.makedirs(directory, exist_ok=True)
+        with open(self.log_path, "a") as f:
+            f.write("# " + json.dumps(self.sampler.describe(), sort_keys=True) + "\n")
+            f.write(",".join(SAMPLE_COLUMNS) + "\n")
+        self._header_written = True
+
+    def _write_sample(self, sample: TopdownSample) -> None:
+        if not self._header_written:
+            self._write_meta()
+        row = sample.to_row()
+        with open(self.log_path, "a") as f:
+            f.write(",".join(str(row.get(column, "")) for column in SAMPLE_COLUMNS))
+            f.write("\n")
+
+    def _mark_invalid(self, reason: str) -> None:
+        """Stamp the output file so it cannot be mistaken for valid data."""
+        self.invalid_reason = reason
+        try:
+            with open(self.log_path, "a") as f:
+                f.write(f"# INVALID: {reason}\n")
+        except OSError:
+            pass
+
+    def check_samples_fail_closed(self) -> dict[str, float]:
+        """Refuse to hand out a top-down profile built from a dead counter.
+
+        A busy CPU always retires instructions and consumes cycles; if those two
+        counted but ``fetch_bubble`` did not, the fetch-bubble event code is dead
+        on this CPU and ``frontend_bound`` would silently read 0 %.
+        """
+        if not self.samples:
+            return {}
+        totals = {
+            counter: sum(sample.counters.get(counter, 0.0) for sample in self.samples)
+            for counter in PMI_COUNTERS
+        }
+        if (
+            totals.get("cycle", 0.0) > 0
+            and totals.get("inst_retired", 0.0) > 0
+            and totals.get("fetch_bubble", 0.0) <= 0
+        ):
+            reason = (
+                "fetch_bubble counted 0 for the whole session while cycles and "
+                f"inst_retired counted normally (totals={totals}); the event code "
+                f"0x{self.sampler.events['fetch_bubble']:x} is dead on this CPU, "
+                "so frontend_bound would be a fake 0%. Data marked invalid."
+            )
+            self._mark_invalid(reason)
+            hint = _override_hint("fetch_bubble", self.sampler.events["fetch_bubble"])
+            raise TopdownEventValidationError(f"{reason}\n{hint}")
+        return totals
+
+    # -- lifecycle ---------------------------------------------------------
+    def sample_once(self) -> TopdownSample:
+        sample = self.sampler.sample()
+        self.samples.append(sample)
+        self._write_sample(sample)
+        return sample
+
+    def start(self) -> None:
+        """Blocking sampling loop (until ``duration_us`` elapses)."""
+        self._write_meta()
+        self.sampler.start()
+        started = time.perf_counter()
+        while True:
+            try:
+                self.sample_once()
+            except TopdownUnavailableError:
+                break
+            if self.duration_us is not None:
+                if (time.perf_counter() - started) * 1e6 >= self.duration_us:
+                    break
+            self._stop_event.wait(self.interval_us / 1e6)
+
+    def start_background(self) -> None:
+        self._write_meta()
+        self.sampler.start()
+        self._stop_event.clear()
+        self._thread = threading.Thread(
+            target=self._run_background, name="LiteProfiler-TopDown", daemon=True
+        )
+        self._thread.start()
+
+    def _run_background(self) -> None:
+        self._stop_event.wait(self.interval_us / 1e6)
+        while not self._stop_event.is_set():
+            try:
+                self.sample_once()
+            except TopdownUnavailableError:
+                break
+            self._stop_event.wait(self.interval_us / 1e6)
+
+    def stop(self) -> list[TopdownSample]:
+        self._stop_event.set()
+        thread = self._thread
+        if thread is not None and thread.is_alive():
+            thread.join(timeout=2.0)
+        self._thread = None
+        self.sampler.stop()
+        # Fail-closed post-check: never hand out a profile whose fetch-bubble
+        # counter was dead for the whole session.
+        self.check_samples_fail_closed()
+        return self.samples
+
+    def __enter__(self) -> "TopdownSession":
+        self.start_background()
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback) -> bool:
+        self.stop()
+        return False
+
+
+def topdown_scope(
+    log_path: str,
+    tid: int | None = None,
+    cpu: int = -1,
+    interval_us: int = 100_000,
+    dry_run: bool = False,
+    validate: bool | None = None,
+) -> TopdownSession:
+    """Context manager sampling PMI counters for the duration of a ``with`` block."""
+    return TopdownSession(
+        log_path=log_path,
+        tid=tid,
+        cpu=cpu,
+        interval_us=interval_us,
+        dry_run=dry_run,
+        validate=validate,
+    )
