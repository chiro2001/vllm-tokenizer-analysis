@@ -0,0 +1,330 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Summarize a LiteProfiler log file.
+
+Parses the thread-level records produced by :mod:`vllm.utils.lite_profiler`
+(see that module for the record format) and prints
+
+1. a pipeline-event table and a model-event table,
+2. a per-scope detail table with count/total/avg/min/max,
+3. a per-thread phase-band table,
+4. the raw time series behind a ``RAW_CSV:`` prefix, so that external scripts
+   can pick it up from stdout.
+
+Everything is grouped by OS thread id (TID), because the only question this
+data family has to answer is "what did *this* thread spend its time on". Rows
+can be restricted to exact TIDs with ``--tid``/``--filter-tid`` (same exact-TID
+semantics as ``scripts/filter_devkit_hotspot.py``).
+
+Both the thread-level 5-column format (``name|dur|start|tid|pid``) and the
+upstream 3-column format (``name|dur|start``, TID unknown) are accepted; rows
+without a TID are reported under TID ``-1`` / pid ``-1``.
+"""
+
+import argparse
+import csv
+import json
+import re
+import statistics
+import sys
+from collections import defaultdict
+from dataclasses import dataclass, field
+
+__all__ = ["emit_lite_profiler_report", "parse_lite_profiler_log", "main"]
+
+_UNKNOWN_TID = -1
+
+# name|duration_us|start_us[|tid|pid]
+_RECORD_RE = re.compile(
+    r"^(?P<name>[^|]+)\|(?P<duration>[0-9]*\.?[0-9]+)\|(?P<start>[0-9]+)"
+    r"(?:\|(?P<tid>[0-9]+)\|(?P<pid>[0-9]+))?$"
+)
+
+# Scopes that belong to the request pipeline / front end rather than to the
+# model execution itself.
+_PIPELINE_PREFIXES = (
+    "Step:",
+    "Input:",
+    "input:",
+    "output:",
+    "http:",
+    "tokenizer:",
+    "llm_engine step:",
+)
+
+
+@dataclass
+class Record:
+    kind: str  # "scope" or "phase"
+    name: str
+    duration_us: float
+    start_us: int
+    tid: int
+    pid: int
+
+    @property
+    def is_pipeline(self) -> bool:
+        return self.name.startswith(_PIPELINE_PREFIXES)
+
+
+@dataclass
+class LogData:
+    path: str
+    total_lines: int = 0
+    unparsed_lines: int = 0
+    records: list[Record] = field(default_factory=list)
+
+    @property
+    def scopes(self) -> list[Record]:
+        return [r for r in self.records if r.kind == "scope"]
+
+    @property
+    def phases(self) -> list[Record]:
+        return [r for r in self.records if r.kind == "phase"]
+
+
+def parse_lite_profiler_log(path: str) -> LogData:
+    """Parse a LiteProfiler log file into :class:`Record` objects."""
+    data = LogData(path=path)
+    with open(path) as f:
+        for raw_line in f:
+            line = raw_line.strip()
+            if not line:
+                continue
+            data.total_lines += 1
+            kind = "scope"
+            body = line
+            if line.startswith("phase: "):
+                kind = "phase"
+                body = line[len("phase: ") :]
+            match = _RECORD_RE.match(body)
+            if match is None:
+                data.unparsed_lines += 1
+                continue
+            tid = int(match.group("tid")) if match.group("tid") else _UNKNOWN_TID
+            pid = int(match.group("pid")) if match.group("pid") else _UNKNOWN_TID
+            data.records.append(
+                Record(
+                    kind=kind,
+                    name=match.group("name"),
+                    duration_us=float(match.group("duration")),
+                    start_us=int(match.group("start")),
+                    tid=tid,
+                    pid=pid,
+                )
+            )
+    return data
+
+
+def _filter(
+    records: list[Record],
+    tids: set[int] | None = None,
+    pids: set[int] | None = None,
+) -> list[Record]:
+    if tids:
+        records = [r for r in records if r.tid in tids]
+    if pids:
+        records = [r for r in records if r.pid in pids]
+    return records
+
+
+def _scope_rows(records: list[Record]) -> dict[int, dict[str, list[float]]]:
+    """{tid: {name: [durations]}} preserving first-seen order."""
+    rows: dict[int, dict[str, list[float]]] = defaultdict(dict)
+    for record in records:
+        rows[record.tid].setdefault(record.name, []).append(record.duration_us)
+    return rows
+
+
+def _print_scope_table(title: str, records: list[Record], top: int | None) -> None:
+    print(f"\n=== {title} ===")
+    rows = _scope_rows(records)
+    if not rows:
+        print("(no events)")
+        return
+    for tid in sorted(rows):
+        per_scope = rows[tid]
+        total = sum(sum(v) for v in per_scope.values())
+        pid = next(r.pid for r in records if r.tid == tid)
+        print(
+            f"\n-- tid={tid} pid={pid} "
+            f"scopes={len(per_scope)} events={sum(len(v) for v in per_scope.values())} "
+            f"total={total / 1000.0:.3f} ms --"
+        )
+        ordered = sorted(
+            per_scope.items(), key=lambda kv: sum(kv[1]), reverse=True
+        )
+        if top is not None:
+            ordered = ordered[:top]
+        print(
+            f"{'scope':<44}{'count':>8}{'total_ms':>12}{'avg_us':>12}"
+            f"{'min_us':>12}{'max_us':>12}"
+        )
+        for name, durations in ordered:
+            print(
+                f"{name:<44}{len(durations):>8}{sum(durations) / 1000.0:>12.3f}"
+                f"{statistics.fmean(durations):>12.3f}{min(durations):>12.3f}"
+                f"{max(durations):>12.3f}"
+            )
+
+
+def _print_phase_table(records: list[Record]) -> None:
+    print("\n=== phase bands (per thread) ===")
+    by_tid: dict[int, list[Record]] = defaultdict(list)
+    for record in records:
+        by_tid[record.tid].append(record)
+    if not by_tid:
+        print("(no phase bands)")
+        return
+    for tid in sorted(by_tid):
+        bands = by_tid[tid]
+        pid = bands[0].pid
+        print(
+            f"\n-- tid={tid} pid={pid} bands={len(bands)} "
+            f"covered={sum(b.duration_us for b in bands) / 1000.0:.3f} ms --"
+        )
+        per_phase: dict[str, list[float]] = defaultdict(list)
+        for band in bands:
+            per_phase[band.name].append(band.duration_us)
+        print(f"{'phase':<24}{'bands':>8}{'total_ms':>12}{'avg_ms':>12}")
+        for name, durations in sorted(
+            per_phase.items(), key=lambda kv: sum(kv[1]), reverse=True
+        ):
+            print(
+                f"{name:<24}{len(durations):>8}{sum(durations) / 1000.0:>12.3f}"
+                f"{statistics.fmean(durations) / 1000.0:>12.3f}"
+            )
+
+
+def _raw_csv(records: list[Record], limit: int | None) -> None:
+    print("\nRAW_CSV:")
+    print("kind,tid,pid,name,duration_us,start_us")
+    ordered = sorted(records, key=lambda r: (r.start_us, r.tid))
+    if limit is not None:
+        ordered = ordered[:limit]
+    writer = csv.writer(sys.stdout, lineterminator="\n")
+    for record in ordered:
+        writer.writerow(
+            [
+                record.kind,
+                record.tid,
+                record.pid,
+                record.name,
+                f"{record.duration_us:.3f}",
+                record.start_us,
+            ]
+        )
+
+
+def emit_lite_profiler_report(
+    path: str,
+    tids: set[int] | None = None,
+    pids: set[int] | None = None,
+    top: int | None = 30,
+    raw_limit: int | None = None,
+) -> LogData:
+    """Print the full LiteProfiler summary for ``path`` and return the parsed data."""
+    data = parse_lite_profiler_log(path)
+    scopes = _filter(data.scopes, tids, pids)
+    phases = _filter(data.phases, tids, pids)
+
+    filter_desc = "all threads"
+    if tids:
+        filter_desc = f"tid in {sorted(tids)}"
+
+    print(
+        f"\n### LiteProfiler report: {path}\n"
+        f"lines={data.total_lines} parsed={len(data.records)} "
+        f"unparsed={data.unparsed_lines} scopes={len(scopes)} "
+        f"phase_bands={len(phases)} "
+        f"filter={filter_desc}"
+    )
+    if not data.records:
+        print("(log is empty or contains no LiteProfiler records)")
+
+    _print_scope_table(
+        "pipeline events (Step:/Input:/http:/tokenizer:/output:)",
+        [r for r in scopes if r.is_pipeline],
+        top,
+    )
+    _print_scope_table(
+        "model events (model:/gpu_model_runner:/npu_model_runner:/...)",
+        [r for r in scopes if not r.is_pipeline],
+        top,
+    )
+    _print_phase_table(phases)
+    _raw_csv(scopes + phases, raw_limit)
+    return data
+
+
+def _parse_args(argv: list[str] | None = None) -> argparse.Namespace:
+    parser = argparse.ArgumentParser(
+        description="Summarize a LiteProfiler log, grouped and filterable by OS TID."
+    )
+    parser.add_argument(
+        "path", help="LiteProfiler log file (VLLM_LITE_PROFILER_LOG_PATH)"
+    )
+    parser.add_argument(
+        "--tid",
+        "--filter-tid",
+        dest="tids",
+        type=int,
+        action="append",
+        default=None,
+        help="only report events of this exact OS thread id (repeatable)",
+    )
+    parser.add_argument(
+        "--pid",
+        dest="pids",
+        type=int,
+        action="append",
+        default=None,
+        help="only report events of this exact process id (repeatable)",
+    )
+    parser.add_argument(
+        "--top",
+        type=int,
+        default=30,
+        help="number of scopes shown per table, 0 for all (default: 30)",
+    )
+    parser.add_argument(
+        "--raw-limit",
+        type=int,
+        default=None,
+        help="maximum number of RAW_CSV rows (default: all)",
+    )
+    parser.add_argument("--json", dest="json_path", default=None)
+    return parser.parse_args(argv)
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = _parse_args(argv)
+    tids = set(args.tids) if args.tids else None
+    pids = set(args.pids) if args.pids else None
+    data = emit_lite_profiler_report(
+        args.path,
+        tids=tids,
+        pids=pids,
+        top=args.top or None,
+        raw_limit=args.raw_limit,
+    )
+    if args.json_path:
+        payload = [
+            {
+                "kind": r.kind,
+                "name": r.name,
+                "duration_us": r.duration_us,
+                "start_us": r.start_us,
+                "tid": r.tid,
+                "pid": r.pid,
+            }
+            for r in _filter(data.records, tids, pids)
+        ]
+        with open(args.json_path, "w") as f:
+            json.dump(payload, f, indent=2)
+        print(f"\n[JSON] wrote {len(payload)} records to {args.json_path}")
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
