--- /tmp/b-artifacts/gigatoken-Cargo.toml.orig	2026-09-24 23:13:55.390070675 +0800
+++ gigatoken/Cargo.toml	2026-09-24 23:13:58.143997406 +0800
@@ -1,3 +1,8 @@
+# NOTE(vendor patch): 删除了上游的 [profile.profiling] / [profile.profiling.package."*"] 两节。
+# 原因：它们用了 nightly 的 `rustflags` profile 键（`profile-rustflags` feature），
+# 会让 **stable cargo 连解析 manifest 都失败**，从而连带整个 workspace 无法构建。
+# 这两节只服务上游 `cargo instruments` 的本地 profile 工作流，不影响库的编译产物。
+# 补丁内容见 vendor/gigatoken-vendor.patch。
 [package]
 name = "gigatoken"
 version = "0.10.0"
@@ -64,21 +69,6 @@
 strip = "none"
 split-debuginfo = "packed"
 
-[profile.profiling]
-inherits = "release"
-debug = 2
-lto = false
-codegen-units = 1
-strip = "none"
-split-debuginfo = "packed"
-# Frame pointers make Instruments' stack unwinding reliable. Mangling is left at
-# the toolchain default (v0); `cargo instruments` demangles v0 symbols itself.
-rustflags = ["-C", "force-frame-pointers=yes"]
-
-[profile.profiling.package."*"]
-debug = 2
-strip = "none"
-
 [dev-dependencies]
 criterion = "0.8"
 fancy-regex = "0.18.0"
